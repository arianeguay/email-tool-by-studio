# Copy to .env and fill in. `.env` is gitignored — never commit real values.

# --- Stage 2 (LLM, via the studio CLI) ---
ANTHROPIC_API_KEY=
# The provider this host runs, for every path that handles real mail (STU-1128). It
# becomes Studio's `--provider`, which beats whatever an agent names for itself; unset,
# `.studio/` decides, which today means `defaults.provider` for every agent. Set it and
# both orchestrations follow — the webhook reads it directly, `make` passes it as the
# flag. Until that only the push path read it, so `make mailbox-full` classified the
# same mailbox under a different provider, and on a host with no ANTHROPIC_API_KEY that
# cost one message inside a run whose stages were all green. A run whose resolved
# provider has no credential now refuses before it reads any mail. Leave it empty and
# nothing here decides; set it and this line is what every path answers to.
STUDIO_PROVIDER=

# --- Gmail fetch (STU-391) — OAuth client downloaded from Google Cloud Console ---
GMAIL_CREDENTIALS_FILE=secrets/credentials.json
GMAIL_TOKEN_FILE=secrets/token.json

# --- Outlook fetch (STU-325) — Azure AD app registration, Mail.Read ---
# Application (client) ID of the registered app.
OUTLOOK_CLIENT_ID=
# `common` (default) covers personal outlook.com and work accounts; pin a tenant
# id to restrict sign-in to one organization. An app-only grant must pin one:
# `common` routes user sign-ins, and client credentials have no user to route.
OUTLOOK_TENANT_ID=common
OUTLOOK_TOKEN_FILE=secrets/outlook-token.json

# --- Outlook app-only grant (STU-1072) — a mailbox this app reaches as itself ---
# Setting the secret selects the app-only flow; leaving it empty keeps the
# public-client interactive sign-in, where the mailbox is whoever consented.
# The two are mutually exclusive by construction, so there is no flag to set.
#
# App-only has no `/me`, so OUTLOOK_MAILBOX is mandatory whenever the secret is
# set — the app refuses rather than guessing which mailbox it was pointed at.
# Scope it in Exchange with an ApplicationAccessPolicy: the application role
# `Mail.ReadWrite` reaches every mailbox in the tenant without one.
OUTLOOK_CLIENT_SECRET=
OUTLOOK_MAILBOX=
# The date that secret expires, as YYYY-MM-DD, read off the app registration
# (STU-1095). A client secret cannot be renewed unattended -- it needs a person in
# the Entra console -- so `make check-webhook` warns 30 days out under exit 6 rather
# than reporting the outage after token requests start failing. Set alongside the
# secret and nowhere else: with a secret configured and no date, the check exits 7
# rather than pass, the way it refuses to guess a port (STU-1087). No secret, no
# expiry: the interactive flow has none, so the leg does not apply at all.
OUTLOOK_SECRET_EXPIRES=

# --- Outlook mail seeder (STU-845) — needs Mail.ReadWrite (`make outlook-consent`) ---
# The mailbox `make seed` is allowed to write synthetic mail into. Mandatory and
# never defaulted: the seeder refuses to write to any other signed-in mailbox.
OUTLOOK_SEED_MAILBOX=

# --- SMTP delivery of fixtures (STU-934) — the outside account `make deliver` sends from ---
# Submission is STARTTLS on DELIVER_SMTP_PORT. The recipient is OUTLOOK_SEED_MAILBOX;
# delivering from that same mailbox is refused, a message a mailbox sends to itself
# never crossing the transport this exists to exercise.
DELIVER_SMTP_HOST=
DELIVER_SMTP_PORT=587
DELIVER_SMTP_USER=
DELIVER_SMTP_PASSWORD=
# Defaults to DELIVER_SMTP_USER; set it only for a relay that sends as another address.
DELIVER_FROM=

# --- Gmail webhook (Pub/Sub push) ---
GMAIL_PUBSUB_TOPIC=
PUBSUB_AUDIENCE=
PUBSUB_SERVICE_ACCOUNT=

# --- Outlook webhook (Graph change notifications, STU-823) ---
# Shared secret echoed in every notification (`openssl rand -hex 16`). Also the
# switch for the Outlook route: unset, the server starts without it.
GRAPH_CLIENT_STATE=
# Public URL of the /graph endpoint, subscribed by `make renew-graph`; unset,
# renewal refuses rather than guessing one.
GRAPH_NOTIFICATION_URL=

# --- Where the webhook listens (STU-978) ---
# The interface and port `make serve-webhook` binds — and, from them, the endpoint
# `make check-webhook` polls, so moving the port needs nothing else. 8080 is a port
# an always-on host has usually already spent, which is why the check refuses to
# guess it: unset, and with no WEBHOOK_HEALTH_URL either, it exits 5 rather than
# poll a port nobody claimed and report the answer as a dead webhook (STU-1087).
# The bind keeps the default — it fails loudly on EADDRINUSE.
WEBHOOK_HOST=127.0.0.1
WEBHOOK_PORT=8080

# --- Inbox mail with no verdict (STU-1502) ---
# The instant `make check-unverdicted` judges the Inbox from, ISO 8601 with a zone.
# No default on purpose: set it to when this host started serving the mailbox,
# or the check refuses under exit 5.
UNVERDICTED_SINCE=

# --- Webhook liveness (STU-931) — both default, override only to tune ---
# Age past which /healthz reports `stale` instead of `ok`.
WEBHOOK_STALE_AFTER_SECONDS=86400
# Only for asking a webhook the two above cannot describe — another machine. That
# is the normal case for `make deliver`, which asks whether the round it just sent
# produced a notification and must ask the staging host, not this checkout
# (STU-1019). Set here to a fixed port, it is what disagrees with WEBHOOK_PORT the
# day that moves, and the cron then polls a port nothing listens on forever.
WEBHOOK_HEALTH_URL=

# The ssh host to reach that URL through, when it names an address that answers
# only on the serving host's loopback — which is the staging webhook, and the
# reason a delivered round could not read the stamp it had just moved (STU-1027).
# The forward is opened for the read and closed with it. Unset on the serving
# host itself, where the URL already resolves. Set without WEBHOOK_HEALTH_URL it
# is refused: the fallback describes the webhook *this* machine would start, so
# forwarding it dials a port the wrong side chose.
WEBHOOK_SSH_HOST=

# --- Alerting (STU-930) ---
# Where a lost Graph grant is announced. The message is POSTed as plain text, so
# an ntfy topic, a Home Assistant webhook, a Slack or Discord hook all work
# as-is. Unset, the alert is a CRITICAL log line on a host nobody is watching.
ALERT_WEBHOOK_URL=
# The second channel (STU-1066), and the one the homelab host actually has. Both
# halves or neither: the messages endpoint is form-encoded, so it cannot be reached
# by pointing ALERT_WEBHOOK_URL at it — a raw-body POST is a 400. Set both and both
# channels fire, independently.
PUSHOVER_TOKEN=
PUSHOVER_USER=
