  "client_footers": [
    "sent\\s+from\\s+my",
    "envoy[ée]\\s+(?:de|[àa]\\s+partir\\s+de)\\s+mon",
    "get\\s+outlook\\s+for",
    "obtenez\\s+outlook\\s+pour",
    "t[ée]l[ée]charger\\s+outlook"
  ],
  "quote_markers": [
    {
      "pattern": "^-{2,}\\s*Message d'origine",
      "flags": [
        "M",
        "I"
      ]
    },
    {
      "pattern": "^-{2,}\\s*Original Message",
      "flags": [
        "M",
        "I"
      ]
    },
    {
      "pattern": "^_{10,}",
      "flags": [
        "M"
      ]
    },
    {
      "pattern": "^\\s*(?:De|From)\\s*:\\s.+(?:\\n.*){0,3}\\n\\s*(?:Objet|Subject|Envoyé|Sent)\\s*:",
      "flags": [
        "M"
      ]
    },
    {
      "pattern": "^Le .{0,80}a écrit\\s*:",
      "flags": [
        "M"
      ]
    },
    {
      "pattern": "^On .{0,80}wrote\\s*:",
      "flags": [
        "M"
      ]
    },
    {
      "pattern": "^\\s*>",
      "flags": [
        "M"
      ]
    }
  ],
  "dictionaries": [
    "/usr/share/hunspell/fr_CA.dic",
    "/usr/share/hunspell/en_CA.dic"
  ],
  "name_line": "\\A([A-ZÀ-Ý][a-zà-ÿ'’-]+(?:[ \\t]+[A-ZÀ-Ý][a-zà-ÿ'’-]+){0,2})[\\s,]*\\Z",
